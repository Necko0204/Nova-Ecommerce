{
  "name": "nova-commerce",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "storefront": "pnpm --filter @nova/storefront dev",
    "admin": "pnpm --filter @nova/admin start",
    "dev": "concurrently -n storefront,admin -c cyan,magenta \"pnpm storefront\" \"pnpm admin\"",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "prepare:admin-env": "node scripts/write-admin-env.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "supabase": "^2.115.0"
  }
}
