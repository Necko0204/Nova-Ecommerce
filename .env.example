# Local Supabase defaults (`supabase start` prints the actual values).
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
NG_APP_SUPABASE_URL=http://127.0.0.1:55321
NG_APP_SUPABASE_ANON_KEY=your-local-anon-key

# Keep service-role keys server-side. Never expose them in either frontend.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
